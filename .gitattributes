# .gitattributes — PRJ_55 Deepfake Audio Detection
# Ensures consistent line endings and marks binary files as non-diffable.

# ── Default: normalise all text files to LF on commit ───────
* text=auto eol=lf

# ── Python source ────────────────────────────────────────────
*.py text eol=lf
*.pyi text eol=lf

# ── Markdown and documentation ───────────────────────────────
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# ── Config and data text formats ─────────────────────────────
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf

# ── Shell scripts ────────────────────────────────────────────
*.sh text eol=lf

# ── Binary files — mark as binary so Git never diffs them ───
*.pt binary
*.pth binary
*.ckpt binary
*.bin binary
*.onnx binary
*.safetensors binary
*.pb binary
*.h5 binary
*.hdf5 binary
*.npy binary
*.npz binary
*.pkl binary
*.pickle binary
*.wav binary
*.flac binary
*.mp3 binary
*.ogg binary
*.opus binary
*.aac binary
*.m4a binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
